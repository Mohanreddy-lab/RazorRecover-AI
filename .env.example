# Public HTTPS origin used for webhook registration and customer links.
APP_URL="https://payments.example.com"
NODE_ENV="production"
PORT="3000"
# SQLite path. Mount /data as a persistent volume in a single-instance deployment.
DATABASE_PATH="/data/razorrecover.db"

# Required when NODE_ENV=production. Use long random values from your secret manager.
AUTH_REQUIRED="true"
AUTH_SESSION_SECRET="replace-with-a-long-random-session-secret"
AUTH_ADMIN_EMAIL="admin@example.com"
AUTH_ADMIN_PASSWORD="replace-with-a-secret-admin-password"
AUTH_MERCHANT_EMAIL="merchant@example.com"
AUTH_MERCHANT_PASSWORD="replace-with-a-secret-merchant-password"

# Razorpay key ID (use rzp_live_... only after validating the production account).
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# Never expose this value to the browser.
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_SECRET"

# Required in production. Set the same value in Razorpay Dashboard > Webhooks.
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"

# Provider adapters. Leave disabled until the corresponding production account is configured.
WHATSAPP_PROVIDER="disabled"
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
BANK_SETTLEMENT_PROVIDER="razorpay"
BANK_SETTLEMENT_API_URL=""
FX_PROVIDER="disabled"
FX_API_URL=""
FX_API_KEY=""
MANDATE_PROVIDER="disabled"
MANDATE_API_URL=""
MANDATE_API_KEY=""

# Browser checkout uses only the public Key ID. Keep every secret server-side.
